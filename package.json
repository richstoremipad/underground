{
  "name": "robotfb-underground-reborn",
  "private": true,
  "version": "1.2.0",
  "description": "ROBOTFB Underground Reborn - Facebook Automation Tool",
  "main": "electron/main.cjs",
  "author": {
    "name": "Rich Dev",
    "email": "richdev@example.com"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder -p never",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "electron-store": "^8.2.0",
    "form-data": "^4.0.5",
    "lucide-react": "^0.475.0",
    "node-machine-id": "^1.1.12",
    "papaparse": "^5.5.3",
    "playwright": "^1.58.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.6.1",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.robotfb.reborn",
    "productName": "RobotFB Reborn",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "dist/logo.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "deb",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "icon.png",
      "category": "Utility",
      "maintainer": "richdev@example.com"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "RobotFB Reborn"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ]
  }
}
